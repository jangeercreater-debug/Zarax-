NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DEPLOYMENT_REGION=local

DATABASE_URL=postgresql://zarax:zarax@localhost:5432/zarax_dev
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
EVENT_BUS_REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-real-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
# Required for outbound SIP calls (POST /rooms/outbound). Create a SIP trunk in the
# LiveKit dashboard under SIP → Trunks and paste the trunk ID here.
# Inbound calls work without this (LiveKit dispatch rules handle routing automatically).
LIVEKIT_SIP_TRUNK_ID=
