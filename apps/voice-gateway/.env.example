NODE_ENV=development
PORT=3001
LOG_LEVEL=info
DEPLOYMENT_REGION=local

DATABASE_URL=postgresql://zarax:zarax@localhost:5432/zarax_dev
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
