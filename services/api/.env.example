NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DEPLOYMENT_REGION=local

DATABASE_URL=postgresql://zarax:zarax@localhost:5432/zarax_dev
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379
EVENT_BUS_REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-real-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Used to build password-reset/email-verification links (points at apps/web).
DASHBOARD_URL=http://localhost:3100

# "Test Agent" reuses llm-orchestrator's real conversation pipeline via HTTP.
LLM_ORCHESTRATOR_URL=http://localhost:3006
LLM_ORCHESTRATOR_SERVICE_ACCOUNT_TOKEN=replace-with-a-real-service-account-token

# Populates the tool multi-select from tool-executor's real catalog. The value must
# match tool-executor's own INTERNAL_SERVICE_TOKEN.
TOOL_EXECUTOR_URL=http://localhost:3004
TOOL_EXECUTOR_INTERNAL_SERVICE_TOKEN=replace-with-a-real-32+-character-shared-secret
# Shared with services/voice-runtime — voice-runtime uses this to fetch agent config
# from the /internal/agents/:id/config endpoint without needing a JWT token.
INTERNAL_SERVICE_TOKEN=replace-with-a-different-32+-character-shared-secret

OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true


