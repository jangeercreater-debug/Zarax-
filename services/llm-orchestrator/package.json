{
  "name": "@zarax/llm-orchestrator",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Owns the conversation state machine — LLM completion (via @zarax/ai-sdk with fallback), tool-call dispatch to tool-executor over the event bus, and optional RAG context from rag-service.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/terminus": "^10.2.3",
    "@zarax/ai-sdk": "workspace:*",
    "@zarax/database": "workspace:*",
    "@zarax/event-bus": "workspace:*",
    "@zarax/redis-client": "workspace:*",
    "@zarax/resilience": "workspace:*",
    "@zarax/shared-auth": "workspace:*",
    "@zarax/shared-config": "workspace:*",
    "@zarax/shared-errors": "workspace:*",
    "@zarax/shared-logger": "workspace:*",
    "@zarax/shared-observability": "workspace:*",
    "@zarax/shared-types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
