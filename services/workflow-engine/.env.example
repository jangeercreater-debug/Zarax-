NODE_ENV=development
PORT=3007
LOG_LEVEL=info
DEPLOYMENT_REGION=local

DATABASE_URL=postgresql://zarax:zarax@localhost:5432/zarax
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-real-32+-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-32+-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# AI Agent node
LLM_ORCHESTRATOR_URL=http://localhost:3006
LLM_ORCHESTRATOR_SERVICE_ACCOUNT_TOKEN=replace-with-a-real-service-account-token

# Knowledge Base node
RAG_SERVICE_URL=http://localhost:3005
RAG_SERVICE_ACCOUNT_TOKEN=replace-with-a-real-service-account-token

# LLM provider keys — only needed here if a node type is added later that calls a
# provider directly; today's AI Agent node goes through llm-orchestrator, which owns
# its own provider keys. Present because llmProvidersEnvSchema is shared/merged in.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
