{
  "name": "@zarax/workflow-engine",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Executes published/draft workflows \u2014 walks the node graph a workflow's visual editor produces, calling out to llm-orchestrator, rag-service, and arbitrary HTTP endpoints per node.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "@zarax/audit-log": "workspace:*",
    "@zarax/database": "workspace:*",
    "@zarax/job-queue": "workspace:*",
    "@zarax/redis-client": "workspace:*",
    "@zarax/resilience": "workspace:*",
    "@zarax/shared-auth": "workspace:*",
    "@zarax/shared-config": "workspace:*",
    "@zarax/shared-errors": "workspace:*",
    "@zarax/shared-logger": "workspace:*",
    "@zarax/shared-observability": "workspace:*",
    "@zarax/shared-types": "workspace:*",
    "bullmq": "^5.13.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "express": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
