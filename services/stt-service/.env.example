NODE_ENV=development
PORT=3002
LOG_LEVEL=info
DEPLOYMENT_REGION=local

DEEPGRAM_API_KEY=

OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# Shared secret for internal service-to-service calls (both the WS transcription
# endpoint and the REST /transcribe endpoint check this) — this service is never
# reachable by end clients directly, only by other internal services.
INTERNAL_SERVICE_TOKEN=replace-with-a-real-32+-character-shared-secret
