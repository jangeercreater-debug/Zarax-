NODE_ENV=development
PORT=3008
LOG_LEVEL=info
DEPLOYMENT_REGION=local

DATABASE_URL=postgresql://zarax:zarax@localhost:5432/zarax_dev
DATABASE_URL_UNPOOLED=postgresql://zarax:zarax@localhost:5432/zarax_dev
DATABASE_POOL_MAX=5

REDIS_URL=redis://localhost:6379
EVENT_BUS_REDIS_URL=redis://localhost:6379

OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# LiveKit — voice-runtime joins rooms as the agent participant
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# STT service (stt-service) — must match stt-service's own INTERNAL_SERVICE_TOKEN
STT_SERVICE_URL=ws://localhost:3002
STT_INTERNAL_SERVICE_TOKEN=replace-with-stt-service-INTERNAL_SERVICE_TOKEN

# TTS service (tts-service) — must match tts-service's own INTERNAL_SERVICE_TOKEN
TTS_SERVICE_URL=ws://localhost:3003
TTS_INTERNAL_SERVICE_TOKEN=replace-with-tts-service-INTERNAL_SERVICE_TOKEN

# LLM orchestrator — same service account pattern as services/api's Test Agent
LLM_ORCHESTRATOR_URL=http://localhost:3006
LLM_ORCHESTRATOR_SERVICE_ACCOUNT_TOKEN=replace-with-llm-orchestrator-service-account-token

# services/api internal endpoint for agent config — must match services/api INTERNAL_SERVICE_TOKEN
API_SERVICE_URL=http://localhost:3000
API_INTERNAL_SERVICE_TOKEN=replace-with-services-api-INTERNAL_SERVICE_TOKEN

# Audio settings — defaults work for Deepgram/Cartesia at 16kHz mono
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
SILENCE_TIMEOUT_MS=1500
