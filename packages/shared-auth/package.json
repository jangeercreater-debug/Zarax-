{
  "name": "@zarax/shared-auth",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 2 \u2014 Principal abstraction, pluggable auth strategies (JWT/API key/service account), and RBAC guards. See /docs/auth-design.md.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@zarax/shared-config": "workspace:*",
    "@zarax/shared-errors": "workspace:*",
    "@zarax/shared-logger": "workspace:*",
    "@zarax/shared-types": "workspace:*",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/passport-jwt": "^4.0.1",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "express": "^4.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "peerDependencies": {
    "express": "^4.21.0",
    "rxjs": "^7.8.1"
  }
}
