generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Neon (and any PgBouncer-fronted Postgres) provides two connection strings: a
// pooled one (safe for the app's runtime queries, many short-lived connections) and
// a direct/unpooled one (required for `prisma migrate deploy` — DDL and PgBouncer's
// transaction-pooling mode don't mix). `url` is what every service's Prisma client
// connects with at runtime; `directUrl` is what `prisma migrate dev`/`deploy` use
// instead. If you're not using a pooler, set DATABASE_URL_UNPOOLED to the same value
// as DATABASE_URL — see docs/deployment.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Tenant — the root of multi-tenancy. Every other table below carries a
// tenant_id foreign key and an index on it (see docs/dependency-rules.md /
// docs/architecture.md for the tenant-isolation principle this encodes).
// ---------------------------------------------------------------------------
model Tenant {
  id         String       @id @default(uuid())
  name       String
  slug       String       @unique
  plan       TenantPlan   @default(FREE)
  status     TenantStatus @default(PENDING_SETUP)
  logoUrl    String?      @map("logo_url")
  industry   String?
  timezone   String?      @default("UTC")
  language   String?      @default("en")
  companyUrl String?      @map("company_url")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  deletedAt  DateTime?    @map("deleted_at")

  memberships     TenantMembership[]
  apiKeys         ApiKey[]
  serviceAccounts ServiceAccount[]
  agents          Agent[]
  calls           Call[]
  phoneNumbers    PhoneNumber[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
  ARCHIVED
}

// ---------------------------------------------------------------------------
// User + TenantMembership — a user can belong to multiple tenants (agency /
// multi-org use case), each membership carrying its own role.
// ---------------------------------------------------------------------------
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String?   @map("full_name")
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  memberships             TenantMembership[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessions                UserSession[]

  @@map("users")
}

model TenantMembership {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  userId      String    @map("user_id")
  role        MemberRole @default(MEMBER)
  suspendedAt DateTime? @map("suspended_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  DEVELOPER
  SUPPORT
  MEMBER
  VIEWER
}

// ---------------------------------------------------------------------------
// ApiKey / ServiceAccount — long-lived, revocable credentials. Only a hash is
// stored, never the raw secret (see @zarax/shared-auth's ApiKeyValidator,
// implemented against this table by services/api).
// ---------------------------------------------------------------------------
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  label       String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix") // first few chars, shown in UI for identification
  scopes      String[]
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model ServiceAccount {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  serviceName  String    @map("service_name")
  tokenHash    String    @unique @map("token_hash")
  scopes       String[]
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("service_accounts")
}

// ---------------------------------------------------------------------------
// Agent / Call — Agent is the full Voice Agent Builder model (M7E); Call remains a
// minimal foundation referent for event contracts (CallStartedEvent.agentId, etc.).
// ---------------------------------------------------------------------------
model Agent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  /// Doubles as the publish/draft flag — see services/api's Voice Agent Builder
  /// (AgentsService.publish()/unpublish()). false ("draft") by default: a newly
  /// created agent isn't reachable by real callers until explicitly published
  /// (voice-gateway's room creation calls AgentRepository.assertPublishedForTenant()).
  isActive  Boolean  @default(false) @map("is_active")
  config    Json     @default("{}")
  /// Incremented on every AgentRepository.createVersion() call — the "current"
  /// version number, mirrored into the latest AgentVersion row.
  currentVersion Int @default(1) @map("current_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls    Call[]
  versions AgentVersion[]

  @@index([tenantId])
  @@map("agents")
}

// ---------------------------------------------------------------------------
// AgentVersion — an immutable snapshot of Agent.config at a point in time.
// Covers both "agent versioning" and "prompt version history" (the system
// prompt lives inside config, per docs/production-standards.md) — a config
// shape with a separately-versioned prompt library is a natural future
// evolution if prompts become shared across agents, not needed today.
// ---------------------------------------------------------------------------
model AgentVersion {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  tenantId  String   @map("tenant_id")
  version   Int
  config    Json
  /// userId of whoever triggered this version, or null for system-generated
  /// (e.g. a rollback triggered by an automated process).
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([tenantId])
  @@map("agent_versions")
}

model Call {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  agentId          String    @map("agent_id")
  channel          CallChannel
  direction        String    @default("inbound") // 'inbound' | 'outbound'
  fromNumber       String?   @map("from_number")
  toNumber         String?   @map("to_number")
  roomName         String?   @map("room_name")
  sipCallId        String?   @map("sip_call_id") // LiveKit SIP participant identity
  recordingUrl     String?   @map("recording_url")
  startedAt        DateTime  @map("started_at")
  endedAt          DateTime? @map("ended_at")
  endReason        String?   @map("end_reason")
  durationMs       Int?      @map("duration_ms")
  llmProvider      String?   @map("llm_provider") // 'anthropic' | 'openai' (whichever served the call)
  turnCount        Int       @default(0) @map("turn_count")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, startedAt])
  @@map("calls")
}

// ---------------------------------------------------------------------------
// Phone numbers — tenant-owned DID numbers provisioned via LiveKit SIP trunk.
// Linking a phone number to an agent makes all inbound calls to that number
// route to the linked agent automatically (via LiveKit SIP dispatch rules set up
// in the LiveKit dashboard — the DB record drives the dashboard config UI).
// ---------------------------------------------------------------------------
model PhoneNumber {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  phoneNumber String    @map("phone_number") // E.164 format e.g. +14155552671
  agentId     String?   @map("agent_id") // nullable — unassigned means the number isn't yet active
  sipTrunkId  String?   @map("sip_trunk_id") // LiveKit SIP trunk ID for outbound calls
  friendlyName String?  @map("friendly_name")
  status      String    @default("active") // 'active' | 'inactive'
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
  @@map("phone_numbers")
}

enum CallChannel {
  VOICE
  PHONE // inbound/outbound SIP telephony via LiveKit SIP
  WEB_WIDGET
}

// ---------------------------------------------------------------------------
// Audit log — one immutable row per sensitive action. Never updated or deleted
// by application code (compliance-grade trail); only ever appended to.
// ---------------------------------------------------------------------------
model AuditLogEntry {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  actorId      String   @map("actor_id")
  actorType    String   @map("actor_type") // 'user' | 'service_account' | 'api_key' | 'system'
  action       String // e.g. 'auth.login', 'auth.signup', 'tool.executed', 'api_key.revoked'
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  correlationId String? @map("correlation_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@map("audit_log_entries")
}

// ---------------------------------------------------------------------------
// Feature flags — a global definition (with an optional default rollout
// percentage) plus per-tenant overrides. Cached in Redis by
// @zarax/feature-flags; this table is the source of truth.
// ---------------------------------------------------------------------------
model FeatureFlag {
  key                String   @id
  description        String
  defaultEnabled     Boolean  @default(false) @map("default_enabled")
  /// 0-100. Only consulted when no explicit tenant override exists.
  rolloutPercentage  Int      @default(0) @map("rollout_percentage")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  overrides FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  flagKey   String   @map("flag_key")
  enabled   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  flag FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([tenantId, flagKey])
  @@index([tenantId])
  @@map("feature_flag_overrides")
}

// ---------------------------------------------------------------------------
// Usage events — one row per billable unit of provider consumption (an LLM
// completion's tokens, an STT/TTS call's audio seconds, a RAG embedding call).
// Serves both cost tracking (costUsd) and usage metering (quantity/unit) from
// the same underlying telemetry — see @zarax/metering and
// docs/production-standards.md.
// ---------------------------------------------------------------------------
model UsageEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  category   String // 'llm' | 'stt' | 'tts' | 'rag_embedding'
  provider   String // 'anthropic' | 'groq' | 'openai' | 'gemini' | 'deepgram' | 'cartesia'
  callId     String?  @map("call_id")
  quantity   Float // meaning depends on `unit`
  unit       String // 'tokens' | 'seconds' | 'characters' | 'calls'
  costUsd    Float    @default(0) @map("cost_usd")
  metadata   Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([tenantId, occurredAt])
  @@index([tenantId, category])
  @@map("usage_events")
}

// ---------------------------------------------------------------------------
// Webhook deliveries — every attempt to deliver an outbound webhook (tenant
// notification hooks, future event-subscription webhooks) is tracked here so
// a permanently-failing endpoint is visible (dead_letter) rather than silently
// dropped. See @zarax/job-queue's WebhookDeliveryService.
// ---------------------------------------------------------------------------
model WebhookDelivery {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  url         String
  payload     Json
  status      String    @default("pending") // 'pending' | 'delivered' | 'failed' | 'dead_letter'
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  @@index([tenantId, status])
  @@map("webhook_deliveries")
}

// ---------------------------------------------------------------------------
// Password reset / email verification tokens — single-use, short-lived,
// stored hashed (never the raw token, same principle as ApiKey/ServiceAccount).
// ---------------------------------------------------------------------------
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// User sessions — one row per issued refresh token, so a "session" is
// listable/revocable server-side. This is what makes logout/session-management
// a real security boundary rather than just a client-side cookie clear (a
// stateless-JWT-only refresh flow, as this service had before this milestone,
// cannot actually revoke a token before it naturally expires).
// ---------------------------------------------------------------------------
model UserSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  tenantId         String    @map("tenant_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ---------------------------------------------------------------------------
// Knowledge base documents — tracks every uploaded/crawled source (PDF, DOCX,
// TXT, URL) through the ingestion pipeline. `extractedText` is stored (not the
// original file bytes — there's no object storage service in this project) so
// re-index can re-chunk/re-embed without needing the original upload again.
// The actual chunks/vectors live in Qdrant, keyed by this row's id
// (payload.documentId) — see @zarax/qdrant-client's deleteByDocumentId.
// ---------------------------------------------------------------------------
model KnowledgeBaseDocument {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  name          String
  sourceType    String    @map("source_type") // 'pdf' | 'docx' | 'txt' | 'url'
  sourceUrl     String?   @map("source_url") // only set for sourceType 'url'
  extractedText String?   @map("extracted_text") @db.Text
  status        String    @default("pending") // 'pending' | 'processing' | 'completed' | 'failed'
  chunkCount    Int       @default(0) @map("chunk_count")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("knowledge_base_documents")
}

// ---------------------------------------------------------------------------
// Workflow — a visual, node-based automation. `definition` holds the full graph
// ({ nodes: [...], edges: [...] }) as JSON, schemaless at the DB level since the
// node/edge shape is owned by the frontend's React Flow editor and the
// workflow-engine's node executors, not by Postgres. Same draft/publish model as
// Agent: `isActive` doubles as the publish flag, false (draft) by default.
// ---------------------------------------------------------------------------
model Workflow {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  name           String
  description    String?
  isActive       Boolean   @default(false) @map("is_active")
  definition     Json      @default("{}")
  currentVersion Int       @default(1) @map("current_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  versions   WorkflowVersion[]
  executions WorkflowExecution[]

  @@index([tenantId])
  @@map("workflows")
}

// Immutable snapshot history — same versioning philosophy as AgentVersion (rollback
// creates a new version matching an old one; history is never rewritten).
model WorkflowVersion {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  tenantId   String   @map("tenant_id")
  version    Int
  definition Json
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([tenantId])
  @@map("workflow_versions")
}

// One row per run. `nodeExecutions` is an embedded, ordered JSON log of each node's
// result (input/output/status/timing) — a separate per-node table would add
// relational complexity a single tenant-scoped JSON column doesn't need at this
// scale (a run's node count is small, typically under a few dozen).
model WorkflowExecution {
  id             String    @id @default(uuid())
  workflowId     String    @map("workflow_id")
  tenantId       String    @map("tenant_id")
  status         String    @default("pending") // 'pending' | 'running' | 'completed' | 'failed'
  triggerType    String    @map("trigger_type") // 'manual' | 'event' (event-based auto-triggering is not yet built — see services/workflow-engine's README)
  input          Json      @default("{}")
  output         Json?
  errorMessage   String?   @map("error_message")
  nodeExecutions Json      @default("[]") @map("node_executions")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, workflowId])
  @@index([tenantId, startedAt])
  @@map("workflow_executions")
}

model UserMemory {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tenantId   String    @map("tenant_id")
  category   String    // 'contact' | 'note' | 'preference' | 'task' | 'fact'
  key        String?
  value      Json
  source     String    @default("voice") // 'voice' | 'text'
  callId     String?   @map("call_id")
  importance Int       @default(1)
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, tenantId])
  @@index([userId, tenantId, category])
  @@map("user_memories")
}

model ConversationSummary {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  callId    String   @map("call_id")
  summary   String
  keyPoints Json     @default("[]")
  mood      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, tenantId])
  @@map("conversation_summaries")
}

model Webhook {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  url             String
  events          String[]
  secret          String
  description     String    @default("")
  isActive        Boolean   @default(true) @map("is_active")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("webhooks")
}

// ============================================================
// VOICE REGISTRY — Phase 1: Voice Engine Foundation
// ============================================================
// Stores system + tenant voices for the Zarax Voice Engine.
// voiceType is designed for future phases:
//   SYSTEM     — built-in Zarax voices, globally available
//   GENERATED  — Phase 3: AI-generated voices
//   CLONED     — Phase 4: consent-based voice cloning
//   CUSTOM     — user-uploaded / custom voices
//   MARKETPLACE — Phase 8: marketplace voices
//
// providerVoiceId maps to the underlying TTS provider's ID
// (e.g. Cartesia voice UUID). Future phases may have no provider
// (self-hosted model) — hence optional.
// ============================================================

enum VoiceType {
  SYSTEM
  GENERATED
  CLONED
  CUSTOM
  MARKETPLACE

  @@map("voice_type")
}

enum VoiceGender {
  MALE
  FEMALE
  NEUTRAL

  @@map("voice_gender")
}

enum VoiceStatus {
  ACTIVE
  INACTIVE
  PENDING

  @@map("voice_status")
}

model Voice {
  id              String      @id @default(uuid())
  /// null = global system voice available to all tenants
  tenantId        String?     @map("tenant_id")
  name            String      @db.VarChar(100)
  description     String?     @db.VarChar(500)
  voiceType       VoiceType   @default(SYSTEM) @map("voice_type")
  gender          VoiceGender @default(NEUTRAL)
  /// BCP-47 primary language tag e.g. "en", "hi", "hi-IN"
  language        String      @default("en") @db.VarChar(10)
  /// Additional supported languages (BCP-47)
  languages       String[]
  accent          String?     @db.VarChar(50)
  ageRange        String?     @map("age_range") @db.VarChar(20)
  style           String?     @db.VarChar(50)
  defaultEmotion  String?     @map("default_emotion") @db.VarChar(30)
  /// TTS provider name: "cartesia" | "openai" | "zarax" | null (self-hosted)
  provider        String?     @db.VarChar(50)
  /// Provider-specific voice ID (e.g. Cartesia UUID)
  providerVoiceId String?     @map("provider_voice_id") @db.VarChar(200)
  /// Provider-specific model (e.g. "sonic-2", "sonic-3")
  model           String?     @db.VarChar(100)
  /// For open-source / custom model speaker embeddings
  speakerId       String?     @map("speaker_id") @db.VarChar(200)
  status          VoiceStatus @default(ACTIVE)
  /// Available to all tenants (system voices only)
  isPublic        Boolean     @default(false) @map("is_public")
  isDefault       Boolean     @default(false) @map("is_default")
  /// Flexible metadata: sample rate, encoding, preview URL, tags, etc.
  metadata        Json?
  sampleAudioUrl  String?     @map("sample_audio_url") @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([isPublic, status])
  @@map("voices")
}

// ============================================================
// VOICE CLONE ENGINE — Phase 4: Consent-Based Voice Cloning
// ============================================================
// VoiceCloneConsent: Records user consent before any audio is processed.
// VoiceCloneProfile: Stores the voice profile metadata after audio validation.
//
// Synthesis state:
//   PROFILE_READY         = profile extracted, GPU synthesis not yet available
//   SYNTHESIS_UNAVAILABLE = explicit state when GPU is not configured
//   SYNTHESIS_READY       = GPU inference service available (Phase 6)
//
// Design: VoiceCloneProfile links to the existing Voice Registry (Voice model)
// via voiceId once synthesis is available. Until then, voiceId is null.
// ============================================================

enum VoiceCloneStatus {
  UPLOADING
  VALIDATING
  PROCESSING
  PROFILE_READY
  SYNTHESIS_UNAVAILABLE
  SYNTHESIS_READY
  FAILED
  INACTIVE

  @@map("voice_clone_status")
}

enum VoiceCloneConsentVersion {
  V1

  @@map("voice_clone_consent_version")
}

model VoiceCloneConsent {
  id              String                   @id @default(uuid())
  tenantId        String                   @map("tenant_id")
  userId          String                   @map("user_id")
  /// Exact consent statement presented and accepted by user
  consentText     String                   @map("consent_text") @db.Text
  consentVersion  VoiceCloneConsentVersion @default(V1) @map("consent_version")
  /// ISO 8601 timestamp from the client when user clicked "I Consent"
  consentedAt     DateTime                 @map("consented_at")
  /// true = user confirmed this is their own voice
  isSelfVoice     Boolean                  @map("is_self_voice")
  /// SHA256 of the consent statement to verify it was not tampered with
  consentHash     String                   @map("consent_hash") @db.VarChar(64)
  ipAddress       String?                  @map("ip_address") @db.VarChar(45)
  userAgent       String?                  @map("user_agent") @db.VarChar(500)
  createdAt       DateTime                 @default(now()) @map("created_at")

  profile VoiceCloneProfile?

  @@index([tenantId, userId])
  @@map("voice_clone_consents")
}

model VoiceCloneProfile {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  userId          String            @map("user_id")
  name            String            @db.VarChar(100)
  description     String?           @db.VarChar(500)
  status          VoiceCloneStatus  @default(UPLOADING)
  consentId       String            @unique @map("consent_id")
  consent         VoiceCloneConsent @relation(fields: [consentId], references: [id])

  /// Audio metadata — never store raw audio in logs
  audioMimeType   String            @map("audio_mime_type") @db.VarChar(50)
  audioDurationS  Float             @map("audio_duration_s")
  audioSizeBytes  Int               @map("audio_size_bytes")
  audioSha256     String            @map("audio_sha256") @db.VarChar(64)
  /// Temporary base64 audio for processing — cleared after embedding extraction
  audioDataBase64 String?           @map("audio_data_base64") @db.Text

  /// Speaker embedding metadata (set when status = PROFILE_READY)
  embeddingModel  String?           @map("embedding_model") @db.VarChar(100)
  embeddingDim    Int?              @map("embedding_dim")
  /// Serialized embedding vector (base64 encoded float32 array)
  embeddingData   String?           @map("embedding_data") @db.Text

  /// Cloning model metadata
  cloningModel    String?           @map("cloning_model") @db.VarChar(100)
  cloningModelVer String?           @map("cloning_model_ver") @db.VarChar(50)

  /// Linked Voice Registry entry (null until synthesis is available)
  voiceId         String?           @map("voice_id")

  /// Error details if status = FAILED
  failureReason   String?           @map("failure_reason") @db.VarChar(500)

  /// Synthesis availability
  synthesisAvail  Boolean           @default(false) @map("synthesis_avail")

  processingStartedAt DateTime?     @map("processing_started_at")
  processingDoneAt    DateTime?     @map("processing_done_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("voice_clone_profiles")
}
