generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant — the root of multi-tenancy. Every other table below carries a
// tenant_id foreign key and an index on it (see docs/dependency-rules.md /
// docs/architecture.md for the tenant-isolation principle this encodes).
// ---------------------------------------------------------------------------
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  plan      TenantPlan   @default(FREE)
  status    TenantStatus @default(PENDING_SETUP)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  memberships     TenantMembership[]
  apiKeys         ApiKey[]
  serviceAccounts ServiceAccount[]
  agents          Agent[]
  calls           Call[]

  @@map("tenants")
}

enum TenantPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_SETUP
  ARCHIVED
}

// ---------------------------------------------------------------------------
// User + TenantMembership — a user can belong to multiple tenants (agency /
// multi-org use case), each membership carrying its own role.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships TenantMembership[]

  @@map("users")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      MemberRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ---------------------------------------------------------------------------
// ApiKey / ServiceAccount — long-lived, revocable credentials. Only a hash is
// stored, never the raw secret (see @zarax/shared-auth's ApiKeyValidator,
// implemented against this table by services/api).
// ---------------------------------------------------------------------------
model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  label       String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix") // first few chars, shown in UI for identification
  scopes      String[]
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model ServiceAccount {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  serviceName  String    @map("service_name")
  tokenHash    String    @unique @map("token_hash")
  scopes       String[]
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("service_accounts")
}

// ---------------------------------------------------------------------------
// Agent / Call — minimal foundation models. Fleshed out in the phase that
// builds services/api and the agent-builder UI; kept here now so
// event contracts (CallStartedEvent.agentId, etc.) have a real referent.
// ---------------------------------------------------------------------------
model Agent {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calls  Call[]

  @@index([tenantId])
  @@map("agents")
}

model Call {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  agentId     String    @map("agent_id")
  channel     CallChannel
  startedAt   DateTime  @map("started_at")
  endedAt     DateTime? @map("ended_at")
  endReason   String?   @map("end_reason")
  durationMs  Int?      @map("duration_ms")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@map("calls")
}

enum CallChannel {
  VOICE
  WEB_WIDGET
}
