{
  "name": "@zarax/database",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 3 — Prisma schema/client and tenant-scoped repository base class enforcing multi-tenant isolation at the query layer.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/terminus": "^10.2.3",
    "@prisma/client": "^5.20.0",
    "@zarax/shared-auth": "workspace:*",
    "@zarax/shared-errors": "workspace:*",
    "@zarax/shared-logger": "workspace:*",
    "@zarax/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
