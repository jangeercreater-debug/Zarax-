DATABASE_URL=postgresql://zarax:zarax@localhost:5432/zarax_dev
# Used by `prisma migrate dev`/`deploy` specifically — required whenever DATABASE_URL
# points at a pooled connection (e.g. Neon's PgBouncer endpoint), since DDL and
# PgBouncer's transaction-pooling mode don't mix. Not using a pooler locally? Set this
# to the same value as DATABASE_URL. See docs/deployment.md.
DATABASE_URL_UNPOOLED=postgresql://zarax:zarax@localhost:5432/zarax_dev
DATABASE_POOL_MAX=10
