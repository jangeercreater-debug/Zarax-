{
  "name": "@zarax/ai-sdk",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 3 — unified LLM provider interface (Claude, Groq, OpenAI, Gemini) so business logic never imports a vendor SDK directly.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@google/generative-ai": "^0.21.0",
    "@zarax/shared-errors": "workspace:*",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
