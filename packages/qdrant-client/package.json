{
  "name": "@zarax/qdrant-client",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 3 — Qdrant wrapper with a per-tenant collection naming strategy for vector-store isolation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
