    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/terminus": "^10.2.3",
    "@qdrant/js-client-rest": "^1.11.0",
    "@zarax/shared-types": "workspace:*"
