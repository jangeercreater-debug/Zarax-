{
  "name": "@zarax/api-standards",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 4 — distributed rate limiting, write-endpoint idempotency, and the standard success-response envelope, applied uniformly across every HTTP-exposing service.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@zarax/redis-client": "workspace:*",
    "@zarax/shared-errors": "workspace:*",
    "@zarax/shared-logger": "workspace:*",
    "@zarax/shared-types": "workspace:*",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "express": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
