{
  "name": "@zarax/shared-logger",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 1 \u2014 structured pino logging with AsyncLocalStorage correlation-id propagation and field redaction.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@opentelemetry/api": "^1.9.0",
