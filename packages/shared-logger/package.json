  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "express": "^4.21.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "peerDependencies": {
    "express": "^4.21.0"
  }
