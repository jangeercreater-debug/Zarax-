{
  "name": "@zarax/job-queue",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 4 — BullMQ-backed background job queues with dead-letter handling, plus a webhook-delivery retry system built on top.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zarax/database": "workspace:*",
    "@zarax/redis-client": "workspace:*",
    "@zarax/resilience": "workspace:*",
    "@zarax/shared-logger": "workspace:*",
    "@zarax/shared-types": "workspace:*",
    "bullmq": "^5.13.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
