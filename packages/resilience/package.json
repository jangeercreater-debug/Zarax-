{
  "name": "@zarax/resilience",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Layer 2 — retry/backoff, timeout, circuit breaker, rate limiting, provider health monitoring, and fallback chains for every outbound call to a third-party provider.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/terminus": "^10.2.3",
    "@zarax/shared-errors": "workspace:*",
    "@zarax/shared-logger": "workspace:*",
    "@zarax/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@zarax/eslint-config": "workspace:*",
    "@zarax/tsconfig": "workspace:*",
    "eslint": "^9.11.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
